{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-save",
    "allow-discovery-env",
    "allow-discovery-list-dir",
    "allow-persist-read-file",
    "allow-persist-backup-file",
    "allow-persist-write-file",
    "allow-persist-save-as-dialog",
    "allow-persist-create-versioned-backup",
    "allow-persist-list-backups",
    "allow-persist-safe-write-file"
  ]
}
